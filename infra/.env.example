# 이 파일을 복사해 infra/.env 로 만들고 값을 채우세요. (.env 는 git 에 올라가지 않음)
# docker-compose 와 Spring Boot(application.yml) 가 같은 파일을 읽습니다.

POSTGRES_DB=coupon_rush
POSTGRES_USER=coupon
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

REDIS_PORT=6379

# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키의 "REST API 키"와 Client Secret
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 네이버 개발자센터 > Application > 내 애플리케이션 의 Client ID / Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT 서명 키 (32바이트 이상 랜덤 문자열)
# 생성 예: PowerShell  [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=
JWT_ACCESS_TOKEN_VALIDITY=30m
JWT_REFRESH_TOKEN_VALIDITY=14d

# refresh token 쿠키 Secure 속성 (로컬 http=false, HTTPS 배포=true)
AUTH_COOKIE_SECURE=false

# 쿠폰 발급 모드 (선택): async(기본, Redis → Kafka → 202) | sync(바로 DB 저장 → 201)
# COUPON_ISSUE_MODE=async
# sync 모드의 재고 동시성 제어 방식 (선택): redis(기본) | conditional-update | pessimistic-lock | optimistic-lock
# COUPON_ISSUE_STRATEGY=redis

# Kafka 튜닝 (선택): 토픽 파티션 수(늘리기만 가능), 서버 1대의 컨슈머 스레드 수(파티션 수 이하)
# KAFKA_TOPIC_PARTITIONS=3
# KAFKA_CONSUMER_CONCURRENCY=3

# 로그인 후 토큰을 전달받을 프론트엔드 주소
FRONTEND_OAUTH2_REDIRECT_URI=http://localhost:5173/oauth/callback
