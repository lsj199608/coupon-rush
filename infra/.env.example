# 이 파일을 복사해 infra/.env 로 만들고 값을 채우세요. (.env 는 git 에 올라가지 않음)
# docker-compose 와 Spring Boot(application.yml) 가 같은 파일을 읽습니다.

POSTGRES_DB=coupon_rush
POSTGRES_USER=coupon
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

REDIS_PORT=6379

# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키의 "REST API 키"와 Client Secret
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# JWT 서명 키 (32바이트 이상 랜덤 문자열)
# 생성 예: PowerShell  [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=
JWT_ACCESS_TOKEN_VALIDITY=30m

# 로그인 후 토큰을 전달받을 프론트엔드 주소
FRONTEND_OAUTH2_REDIRECT_URI=http://localhost:5173/oauth/callback
