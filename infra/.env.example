# Coupon Rush 환경변수 예시
# 사용법: 이 파일을 infra/.env 로 복사한 뒤 값을 채운다. (.env 는 .gitignore 대상 — 절대 커밋하지 않는다)
#   PowerShell: Copy-Item infra\.env.example infra\.env
# docker compose(infra/) 와 Spring Boot(backend/, application.yml 의 spring.config.import) 가 이 한 파일을 같이 읽는다.
# 값을 바꾸면 docker compose / bootRun 을 다시 시작해야 반영된다. 각 항목 설명은 README.md "환경변수" 참고.
#
# ⚠ 선택 항목은 주석(#)을 풀 때만 값을 넣는다. "KEY=" 처럼 빈 값으로 두면 Spring 이 기본값 대신 빈 문자열을 쓴다.
# ⚠ 값 뒤에 주석을 붙이지 않는다 (KEY=value # 설명 X). Spring 은 이 파일을 .properties 로 읽어서 "# 설명"까지 값이 된다.

# ─────────────────────────── 필수 ───────────────────────────

# PostgreSQL — 컨테이너 최초 생성 시 이 값으로 DB/계정이 만들어지고, 백엔드도 같은 값으로 접속한다
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# JWT 서명 키 — 32바이트 이상 랜덤 문자열
#   생성 예 (PowerShell): [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=

# 소셜 로그인 — 각 콘솔에 Redirect URI 로 http://localhost:8080/login/oauth2/code/{kakao|naver|google} 등록
# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 "REST API 키" / 보안 > Client Secret
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 네이버 개발자센터 > Application > 내 애플리케이션 > Client ID / Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────── 선택 (주석 = 기본값 사용) ────────────────────

# 접속 위치 — 기본은 로컬 docker compose
# 기본 localhost
# POSTGRES_HOST=
# 기본 5432 (compose 가 여는 호스트 포트도 이 값)
# POSTGRES_PORT=
# 기본 localhost
# REDIS_HOST=
# 기본 6379
# REDIS_PORT=
# 기본 localhost:9092
# KAFKA_BOOTSTRAP_SERVERS=

# 토큰 유효기간 — 기본 30m / 14d
# JWT_ACCESS_TOKEN_VALIDITY=
# JWT_REFRESH_TOKEN_VALIDITY=
# refresh 쿠키 Secure 속성 — 기본 false (로컬 http). HTTPS 배포에서는 true
# AUTH_COOKIE_SECURE=

# 로그인 성공/실패 후 돌아갈 프론트 주소 — 기본 http://localhost:5173/oauth/callback
# FRONTEND_OAUTH2_REDIRECT_URI=

# 발급 모드 — 기본 async (Redis → Kafka → 202) | sync (바로 DB 저장 → 201)
# COUPON_ISSUE_MODE=
# sync 모드의 재고 제어 방식 — 기본 redis | conditional-update | pessimistic-lock | optimistic-lock
# COUPON_ISSUE_STRATEGY=
# Redis ↔ DB 대조 점검 스케줄러(10분, 불일치만 WARN 로그) — 기본 true
# COUPON_RECONCILE_ENABLED=

# Kafka 토픽 파티션 수 — 기본 3 (늘리기만 가능)
# KAFKA_TOPIC_PARTITIONS=
# Kafka 토픽 복제 수 — 기본 1 (로컬 단일 브로커, 운영 3)
# KAFKA_TOPIC_REPLICAS=
# 서버 1대의 컨슈머 스레드 수 — 기본 3 (파티션 수 이하)
# KAFKA_CONSUMER_CONCURRENCY=

# LLM 문구 생성 (coupon-api 쪽) — 요청 마감, 기본 60s (지나면 TIMEOUT)
# LLM_REQUEST_TIMEOUT=
# 관리자 1명의 분당 / 일일 요청 한도 — 기본 5 / 50 (일일은 한국 자정 초기화)
# LLM_RATE_LIMIT_PER_MINUTE=
# LLM_RATE_LIMIT_PER_DAY=

# LLM 제공자 (llm-service 만 읽음) — 기본 fake (API 키·비용 없이 정해진 문구)
#   anthropic 으로 바꾸고 LLM_API_KEY 를 넣으면 실제 Claude 를 부른다 (키가 비어 있으면 자동으로 fake)
# LLM_PROVIDER=
# Anthropic API 키 (console.anthropic.com > API Keys). 비밀값 — 절대 커밋하지 않는다
# LLM_API_KEY=
# 모델 ID — 기본 claude-sonnet-5-5 (저렴하게: claude-haiku-5-5, 고품질: claude-opus-5-5)
# LLM_MODEL=
# 서비스 전체 일일 토큰(입력+출력) 예산 — 기본 50000, 한국 자정 초기화. coupon-api·llm-service 가 같은 값을 읽는다
# LLM_DAILY_TOKEN_BUDGET=
